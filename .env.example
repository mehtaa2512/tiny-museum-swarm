# Optional overrides. Copy to .env and load it in your shell; this app never reads
# or serves secret values back to the browser.

# OpenAI provider
OPENAI_API_KEY=

# Generic OpenAI-compatible provider (LM Studio, vLLM, etc.)
OPENAI_COMPATIBLE_API_KEY=

# Server
TINY_MUSEUM_HOST=127.0.0.1
TINY_MUSEUM_PORT=8765
TINY_MUSEUM_CONFIG=config/agents.json
